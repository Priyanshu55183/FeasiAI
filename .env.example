# FeasiAI — AI Solution Feasibility & Proposal Copilot
# Copy this to .env and fill in your values

# === LLM Provider ===
# Groq API key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model name — Llama 3.3 70B on Groq free tier
LLM_MODEL=llama-3.3-70b-versatile

# === Paths ===
# Where ChromaDB persists its data
CHROMA_PERSIST_DIR=./chroma_db

# Directory containing institutional knowledge documents
MEMORY_DOCS_DIR=./data/memory

# === Retrieval tuning ===
# Number of results to return from each retrieval method before fusion
RETRIEVAL_TOP_K=5

# Weight for dense vs sparse in RRF (0.0 = all sparse, 1.0 = all dense)
DENSE_WEIGHT=0.5

# === LLM call budget (Phase 1: simple limits) ===
# Max LLM calls per pipeline run (safety valve)
MAX_LLM_CALLS_PER_RUN=50

# === Embedding model ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Planner Agent (Phase 2) ===
# Enable the planner agent (true/false). When false, uses Phase 1 single-shot.
USE_AGENT=true

# Max tool calls per requirement before forcing classification
AGENT_MAX_STEPS=3

# Confidence threshold for early stopping (0.0–1.0)
AGENT_CONFIDENCE_THRESHOLD=0.85

# === Live Data Layer (Phase 3) ===
# All live data connectors are OPT-IN. If not set, they silently return []
# and the pipeline works identically to Phase 2.

# --- Jira Connector ---
# Set all three to enable Jira issue search.
# API tokens: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token_here
# Optional: comma-separated Jira project keys to scope search (leave blank for all)
JIRA_PROJECT_KEYS=ENG,INFRA

# --- Roadmap Connector ---
# Path to a local YAML or JSON roadmap file (see data/roadmap.yaml for format)
ROADMAP_FILE_PATH=./data/roadmap.yaml

